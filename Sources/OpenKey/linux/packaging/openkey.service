[Unit]
Description=OpenKey — bộ gõ tiếng Việt
Documentation=https://github.com/tuyenvm/OpenKey
# Chi co nghia trong phien do hoa: OpenKey can Wayland hoac X11 de bat ban phim.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@OPENKEY_BIN@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
