# ACL chi cap cho user dang hoat dong tai seat; khong trao quyen doc ban phim
# vinh vien cho moi process cua tat ca thanh vien nhom input.
SUBSYSTEM=="misc", KERNEL=="uinput", TAG+="uaccess", OPTIONS+="static_node=uinput"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess"
