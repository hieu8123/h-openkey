[Unit]
Description=H-OpenKey — bộ gõ tiếng Việt
Documentation=https://github.com/tuyenvm/OpenKey
# Chay trong phien do hoa de compositor/X server nhan ban phim uinput.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@OPENKEY_BIN@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
